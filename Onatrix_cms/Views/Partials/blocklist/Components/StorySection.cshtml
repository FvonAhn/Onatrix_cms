@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.StorySection)Model.Content;
}

<section class="relative flex flex-col items-center overflow-hidden">
         
    <div class="absolute">
        @if (content.StoryBgImage != null)
        {
            <img src="@content.StoryBgImage.Url()" class="w-[1170px] h-[540px]" />
        }
    </div>


    <div class="relative min-h-[932px] z-10 max-w-7xl mx-auto flex flex-col items-center justify-end gap-6">
        <div class="flex flex-col items-center">
            <div class="text-[40px] font-extrabold">@content.StoryTitle</div>
            <h2 class="text-[40px] text-sub-300 font-extrabold">@content.StoryLabel</h2>
        </div>

        <div class="flex flex-col items-center gap-4">
            <p>@content.StoryText</p>
            @if (content.StoryLink != null)
            {
                <a class="bg-main text-sub-100 py-3 px-10 no-underline rounded cursor-pointer font-bold" href="@content.StoryLink.Url">@content.StoryLink.Name</a>
            }
        </div>
        @if (content.StoryImage != null)
        {
            <img src="@content.StoryImage.Url()" class="mt-[90px]" />
        }
    </div>

</section>